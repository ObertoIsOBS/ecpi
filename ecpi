#!/usr/bin/env python3
"""
ecpi - Easy Cross-Package Installer for Arch Linux

Identifies available package managers (pacman, paru, yay, yum, fisher, git),
searches for packages across them, offers fuzzy matches, explains results,
and asks for confirmation before installing.
"""

import argparse
import os
import subprocess
import sys
from difflib import get_close_matches

# Ensure project root is on path when run as ./ecpi
_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if _SCRIPT_DIR not in sys.path:
    sys.path.insert(0, _SCRIPT_DIR)

from ecpi_lib.managers import (
    detect_managers,
    get_search_results,
    get_installed_results,
    get_installed_names_for_fuzzy,
    install_package,
    uninstall_package,
    git_clone_result,
    list_installers_for_display,
)
from ecpi_lib.present import explain_and_confirm, explain_and_confirm_uninstall, paginated_search_only
from ecpi_lib.post_install import offer_post_install_actions, remove_desktop_shortcuts_for_package, offer_remove_leftover_files


def main():
    parser = argparse.ArgumentParser(
        prog="ecpi",
        description="Install packages using the best available package manager (pacman, paru, yay, yum, fisher, or git). Searches across managers, suggests similar packages if no exact match, and asks for confirmation before installing.",
        epilog="With no arguments, this help is shown. Use --show-installers to list detected installers for the current $SHELL.",
    )
    parser.add_argument(
        "query",
        nargs="*",
        help="Package name(s) or search term(s) to search for and optionally install",
    )
    parser.add_argument(
        "-y", "--yes",
        action="store_true",
        help="Skip all confirmation prompts; install immediately and skip post-install PATH/desktop prompts",
    )
    parser.add_argument(
        "--search-only",
        action="store_true",
        help="Only search and display results (paginated); do not prompt to install",
    )
    parser.add_argument(
        "--no-fuzzy",
        action="store_true",
        help="Do not suggest similar package names when there is no exact match",
    )
    parser.add_argument(
        "--show-installers",
        action="store_true",
        help="List available package installers for the current environment and whether each is active for $SHELL (e.g. fisher only when using fish)",
    )
    parser.add_argument(
        "-U", "--uninstall",
        action="store_true",
        help="Uninstall a package: search installed packages, choose one, then remove desktop shortcuts and optionally leftover user files",
    )
    parser.add_argument(
        "--verbose-install",
        action="store_true",
        dest="verbose_install",
        help="Use extra verbose output during install (pacman -v, yum -v). Helps when output goes quiet during long installs. Can also set ECPI_VERBOSE=1.",
    )
    args = parser.parse_args()
    if os.environ.get("ECPI_VERBOSE", "").strip() in ("1", "yes", "true"):
        args.verbose_install = True

    if args.show_installers:
        show_installers()
        return

    query = " ".join(args.query).strip()
    if not query:
        parser.print_help()
        sys.exit(0)

    managers = detect_managers()
    if not managers:
        print("ecpi: No supported package manager found (pacman, paru, yay, yum, fisher).")
        sys.exit(1)

    if args.uninstall:
        run_uninstall(managers, query, args)
        return

    results = get_search_results(managers, query)

    # If no results, try fuzzy suggestions from repo list (pacman/paru/yay)
    if not results and not args.no_fuzzy:
        fuzzy = try_fuzzy_suggestions(managers, query)
        if fuzzy:
            print(f"No exact match for '{query}'. Did you mean one of these?")
            results = fuzzy

    # If still no results, offer git clone when query looks like a repo URL or owner/repo
    if not results and git_clone_result(query):
        results = [git_clone_result(query)]
        print(f"No package found for '{query}'. You can clone it as a git repository:")

    if not results:
        print(f"No packages found for '{query}'.")
        if not args.no_fuzzy:
            print("Tip: Try a different search term or use --search-only to see raw search output.")
        sys.exit(1)

    if args.search_only:
        paginated_search_only(results, query)
        return

    choice = explain_and_confirm(results, query, skip_confirm=args.yes)
    if choice is None:
        print("Cancelled.")
        sys.exit(0)

    ok = install_package(managers, choice, verbose_install=args.verbose_install)
    if ok:
        offer_post_install_actions(
            choice["manager"],
            choice["name"],
            skip_confirm=args.yes,
        )
    sys.exit(0 if ok else 1)


def run_uninstall(managers: list, query: str, args) -> None:
    """Uninstall flow: search installed packages, confirm, remove shortcuts, uninstall, offer leftover cleanup."""
    results = get_installed_results(managers, query)

    if not results and not args.no_fuzzy:
        installed_tuples = get_installed_names_for_fuzzy(managers)
        if installed_tuples:
            names = [t[0] for t in installed_tuples]
            name_to_result = {t[0]: t[1] for t in installed_tuples}
            matches = get_close_matches(query.lower(), names, n=10, cutoff=0.4)
            if matches:
                print(f"No exact match for '{query}'. Similar installed packages:")
                results = [name_to_result[n] for n in matches]

    if not results:
        print(f"No installed packages found matching '{query}'.")
        if not args.no_fuzzy:
            print("Tip: Try a different search term or use --no-fuzzy to disable similar-package suggestions.")
        sys.exit(1)

    choice = explain_and_confirm_uninstall(results, query, skip_confirm=args.yes)
    if choice is None:
        print("Cancelled.")
        sys.exit(0)

    # Remove desktop shortcuts while package is still installed (so we can list its files)
    remove_desktop_shortcuts_for_package(choice["manager"], choice["name"])

    ok = uninstall_package(managers, choice)
    if ok:
        offer_remove_leftover_files(choice["name"], skip_confirm=args.yes)
    sys.exit(0 if ok else 1)


def show_installers() -> None:
    """Print detected package managers and which are active for current shell."""
    installers = list_installers_for_display()
    shell = os.environ.get("SHELL", "unknown")
    print(f"Current shell: {shell}\n")
    print("Available package installers:\n")
    for m in installers:
        sources = ", ".join(m.get("sources", []))
        if m.get("active_for_shell"):
            tag = " (active for this shell)"
        elif m.get("shell"):
            tag = f" (use when SHELL is {m['shell']})"
        else:
            tag = " (system-wide)"
        print(f"  {m['name']}: {m['bin']}")
        print(f"    Sources: {sources}{tag}")
        print()
    if not installers:
        print("  No supported installers found.")


def try_fuzzy_suggestions(managers: list, query: str) -> list:
    """If no search results, get package list and suggest close matches."""
    for m in managers:
        if m.get("name") not in ("pacman", "paru", "yay"):
            continue
        # Get all package names for fuzzy match (only when no exact results)
        try:
            cmd = [m["bin"]] + m.get("list_all_cmd", [])
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
            if out.returncode != 0 or not out.stdout:
                continue
            names = [n.strip() for n in out.stdout.splitlines() if n.strip()]
            matches = get_close_matches(query.lower(), names, n=10, cutoff=0.4)
            if not matches:
                continue
            # Dedupe (pacman -Slq can list same name from multiple repos)
            seen = set()
            unique = [p for p in matches if p not in seen and not seen.add(p)]
            return [
                {
                    "manager": m["name"],
                    "bin": m["bin"],
                    "name": pkg,
                    "source": "fuzzy suggestion",
                    "description": "Possible match (no exact search hit)",
                }
                for pkg in unique
            ]
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
    return []


if __name__ == "__main__":
    main()
